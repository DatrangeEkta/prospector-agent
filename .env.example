# Copy to .env and `source .env` (or export these) to change models or folders. Defaults work with local Ollama.

# The AI that checks papers, decides the next search step and writes notes
WRITER_MODEL=gemma4:e4b
WRITER_URL=http://localhost:11434/v1/chat/completions
# WRITER_API_KEY=            # company endpoint (e.g. M006 V4-Flash) only

# The AI that checks every claim against the paper's abstract (may be a different model from the writer)
# JUDGE_MODEL=gemma4:e4b
# JUDGE_URL=http://localhost:11434/v1/chat/completions

# Confidence below this (%) is shown as low confidence, in light red
# PROSPECTOR_LOW_CONFIDENCE=50
# Minutes one manual search takes (weekly summary "time saved" estimate): replace with your measured baseline
# PROSPECTOR_MANUAL_MINUTES=30

# Meaning search
EMBED_MODEL=nomic-embed-text
EMBED_URL=http://localhost:11434/api/embed

# Folders and web app
# PROSPECTOR_DATA=/path/to/data
# PORT=8081
# PROSPECTOR_ADMIN_TOKEN=change-me   # needed for POST /api/run
